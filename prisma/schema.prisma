// Prisma schema — SKETCH translating the current Mongoose models to Postgres.
//
// Design notes:
// - Deeply nested personal-history sub-documents (education, profession,
//   parents, religion, siblings, `partner`, `otherInfo`) are genuinely
//   document-shaped and almost never filtered by inner field, so they stay as
//   `Json` (Postgres jsonb). The fields you DO query/report on (gender,
//   dateOfBirth, name, phoneNumber, timestamps) are promoted to real columns.
// - Mongo ObjectIds become cuid() string PKs. Switch to Int @id @default(autoincrement())
//   if you prefer.
// - `lessonsCompleted` (embedded array on Couple) becomes the CoupleLessonCompleted
//   join table, so "completed lessons" reporting is a plain JOIN/COUNT.
// - Upload refs ({ id, name }) are stored as Json; `id` is the storage key.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection, used for ordinary queries. A serverless Postgres puts a
  // connection pooler in front, which is what lets many short-lived
  // connections share a small number of real ones.
  url       = env("DATABASE_URL")
  // Unpooled connection, used only for migrations. Schema changes need a real
  // session — the pooler runs in transaction mode and hands out a different
  // backend per statement, so `migrate deploy` cannot rely on session state
  // and will misbehave against it.
  //
  // This is required once declared: Prisma fails to load the schema if
  // DIRECT_URL is missing, it does not fall back. On a plain single-server
  // Postgres, where there is no pooler and no distinction to make, set it to
  // the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  headCounsellor
  counsellor
}

enum UserStatus {
  active
  banned
  awaitingConfirmation
}

enum Gender {
  male
  female
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  firstName           String
  lastName            String
  password            String
  phoneNumber         String?
  role                UserRole
  status              UserStatus @default(awaitingConfirmation)
  availability        Boolean    @default(true)
  tokenIssuedAt       Int?
  // Nonce for the outstanding password-reset/invite link. Matched against the
  // token's claim and cleared on use, which is what makes those links
  // single-use — JWT `iat` is second-granular and cannot express this.
  resetTokenId        String?
  profilePicture      String?
  // Consecutive failed sign-ins, reset on success. Rate limiting alone is by
  // IP, which both locks out a whole office sharing one connection and does
  // little against attempts spread across many addresses at one account.
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // A counsellor is assigned to many couples
  couples   Couple[]   @relation("CounsellorCouples")
  auditLogs AuditLog[]

  @@index([role])
  @@index([role, availability])
}

model Couple {
  id                 String   @id @default(cuid())
  completed          Boolean  @default(false)
  counsellorAccepted String?
  // Short code the couple types into the intake form so their answers attach
  // to the right record. Nullable because couples registered before this
  // existed have none, and phone matching remains as a fallback.
  referenceCode      String?  @unique
  // Couple "letter" file reference ({ id, name })
  letterFileId       String?
  letterFileName     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  counsellorId String?
  counsellor   User?   @relation("CounsellorCouples", fields: [counsellorId], references: [id])

  // partners[] on the Mongo model -> one couple has many partner records
  partners         Partner[]
  lessonsCompleted CoupleLessonCompleted[]
  assignments      Assignment[]
  questionnaires   Questionnaire[]

  @@index([counsellorId])
  @@index([completed])
  @@index([counsellorId, completed])
  @@index([createdAt])
  @@index([updatedAt])
}

// Was: CouplesDetails
model Partner {
  id          String    @id @default(cuid())
  name        String
  phoneNumber String?
  dateOfBirth DateTime?
  gender      Gender?
  hometown    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Document-shaped history kept as jsonb (rarely queried by inner field)
  education           Json?
  profession          Json?
  parents             Json?
  partner             Json?
  religion            Json?
  siblings            Json?
  otherInfo           Json?
  churchAfterMarriage String?
  orderOfBirth        String?
  // When this partner's intake form arrived. Null means the record is still a
  // stub created at registration, which is what the dashboard chases up.
  formSubmittedAt     DateTime?

  coupleId String?
  couple   Couple? @relation(fields: [coupleId], references: [id])

  questionnaires Questionnaire[]

  @@index([coupleId])
  @@index([gender])
  @@index([phoneNumber])
}

model Lesson {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completedBy CoupleLessonCompleted[]
  assignments Assignment[]
}

// Was: the embedded lessonsCompleted[] array on Couple
model CoupleLessonCompleted {
  id            String   @id @default(cuid())
  coupleId      String
  lessonId      String
  dateCompleted DateTime @default(now())

  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([coupleId, lessonId])
  @@index([coupleId])
}

model Assignment {
  id        String   @id @default(cuid())
  uploads   Json? // [{ id, name }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  couplesId String
  couple    Couple @relation(fields: [couplesId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson @relation(fields: [lessonId], references: [id])

  @@index([couplesId])
}

model Questionnaire {
  id        String   @id @default(cuid())
  type      String // "pre-test" | "post-test"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // What the respondent actually typed, kept verbatim and separately from the
  // resolved links below. A submission that cannot be matched has no partner
  // and no couple, so without these there is nothing left to identify it by —
  // the identifying fields were stripped before the answers were stored, and
  // an unmatched row was an anonymous list of answers nobody could place.
  submittedContact       String?
  submittedName          String?
  submittedReferenceCode String?
  submittedGender        String?

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])
  coupleId  String?
  couple    Couple?  @relation(fields: [coupleId], references: [id])

  responses QuestionnaireResponse[]

  @@index([partnerId])
  @@index([coupleId])
}

// Was: the embedded response[] array ({ question, answer })
model QuestionnaireResponse {
  id       String @id @default(cuid())
  question String
  answer   String

  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
}

model Form {
  id        String   @id @default(cuid())
  name      String
  link      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resource {
  id        String   @id @default(cuid())
  name      String
  uploads   Json? // [{ id, name }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Who did what, to whose record, and when.
//
// These are counselling files — sexual history, abuse disclosures, health
// status — and until now nothing recorded that a given counsellor opened a
// given couple's record or downloaded their letter. That is the first thing
// anyone investigating a suspected breach would ask for, and it cannot be
// reconstructed after the fact.
//
// Rows are written for reads as well as writes, and are never updated: an
// audit trail that can be edited is not one.
model AuditLog {
  id        String   @id @default(cuid())
  action    String // e.g. "couple.view", "media.download", "auth.login.failed"
  createdAt DateTime @default(now())

  // Nullable because a failed sign-in has no authenticated actor. The email is
  // stored alongside the id so the trail still reads correctly once an account
  // is deleted, and so a failed attempt on an unknown address is still useful.
  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  actorRole  String?

  // What was acted on: "couple", "partner", "media", "user", "questionnaire".
  targetType String?
  targetId   String?

  // Request context, for telling a routine action apart from an odd one.
  ipAddress String?
  userAgent String?

  // Anything else worth keeping — which media keys, which fields changed.
  // Never the record contents themselves; this is a trail, not a copy.
  metadata Json?

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
  @@index([targetType, targetId])
}
