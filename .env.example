# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://user:password@localhost:5432/counselling

# JWT signing secret
TOKEN_SECRET=change-me

# Server port (defaults to 3000)
PORT=3000

# App URL used in emails (password reset / assignment links)
APP_URL=http://localhost:3001

# Cloudinary
CLOUD_NAME=
API_KEY=
API_SECRET=

# Google Drive service account (file storage)
PROJECT_ID=
PRIVATE_KEY=
CLIENT_EMAIL=
CLIENT_ID=
CLIENT_CERT_URL=
ASSIGNMENTS_FOLDER_ID=
LESSONS_FOLDER_ID=
LETTERS_FOLDER_ID=
PROFILE_PICTURES_FOLDER_ID=
