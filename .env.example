# PostgreSQL connection used by Prisma for ordinary queries.
# On a serverless Postgres (Neon and similar) this is the POOLED connection —
# its hostname contains "-pooler".
DATABASE_URL=postgresql://user:password@localhost:5432/counselling

# Unpooled connection, used only to run migrations. Same string as above but
# without "-pooler" in the hostname.
# Required: Prisma will not load the schema if this is unset. On a plain
# single-server Postgres, where there is no pooler, set it to the same value
# as DATABASE_URL.
DIRECT_URL=postgresql://user:password@localhost:5432/counselling

# JWT signing secret
TOKEN_SECRET=change-me

# How long a signed-in session lasts. Defaults to 8 hours (28800s) — a working
# day. The portal renews the token while someone is using the app, so a shorter
# value is not felt; a longer one widens the window on a token sitting in a
# browser on a shared machine. Sessions can be revoked immediately regardless,
# because tokenIssuedAt is checked on every request.
TOKEN_TTL=28800s

# Server port (defaults to 3000)
PORT=3000

# App URL used in emails (password reset / invite / assignment links). Also the
# default allowed browser origin for both the API and the socket.
APP_URL=http://localhost:3001

# Browser origins allowed to call the API and open a socket, comma-separated.
# Only needed when the portal is served from somewhere other than APP_URL (a
# staging domain, a www/apex pair). Leave blank and APP_URL is used.
# If neither is set, every origin is accepted and a warning is logged.
CORS_ORIGINS=

# Number of reverse proxies in front of this process. Managed hosts (Render,
# Railway, Fly, an nginx front) put exactly one there, so set this to 1 in
# production — without it every request looks like it came from the proxy and
# the rate limiters throttle all users as though they were one client.
# Leave blank locally, where nothing sits in front of the app.
TRUST_PROXY=

# First head counsellor, created by `npm run prisma:seed`. Every other account
# is created through the invite flow, which needs a head counsellor to exist.
# Change the password on first login; these are bootstrap credentials only.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Head
SEED_ADMIN_LAST_NAME=Counsellor

# Shared secret the Google Form's Apps Script sends as the X-Form-Secret header
# on /couples/details and the questionnaire endpoints. Those are filled in by
# counsellees who have no account, so they cannot sit behind a login.
# Leave blank and they stay open (a warning is logged at each request).
# Update the Apps Script FIRST, then set this — the other order rejects live
# submissions.
FORM_SHARED_SECRET=

# Default region for parsing phone numbers typed without a country code.
DEFAULT_PHONE_REGION=GH

# Gmail account used to send invite, password-reset and assignment mail.
# GOOGLE_APP_PASSWORD is an App Password, not the account password — it needs
# 2-Step Verification enabled on the account first. Without both, inviting a
# counsellor creates an account nobody can reach.
EMAIL=
GOOGLE_APP_PASSWORD=

# Intake form link with the couple's reference code prefilled, so neither
# partner has to transcribe it. Get it from the form:
#   ⋮ menu -> "Get pre-filled link" -> type anything into Reference Code ->
#   "Get link" -> copy, then replace the value you typed with {{code}}
# Leave blank and the dashboard shows the bare code instead.
INTAKE_FORM_PREFILL_URL=

# Cloudflare R2 (file storage)
# Account ID is in the Cloudflare dashboard URL; the key pair comes from
# R2 > Manage API tokens, scoped to Object Read & Write on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

